# Environment: development, test, production
APP_ENV=development
APP_NAME="Movie Insight Engine"
APP_SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: SQLite for local dev/testing, PostgreSQL for production
DATABASE_URL=sqlite:///./movie_insight.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/movie_insight

# External Metadata Providers (Optional - built-in catalog fallback activates if empty)
TMDB_API_KEY=
JIKAN_BASE_URL=https://api.jikan.moe/v4

# CORS: Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO
